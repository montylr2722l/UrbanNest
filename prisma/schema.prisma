// =============================================================================
// UrbanNest — Prisma Schema
// Multi-vendor fashion marketplace
// =============================================================================
//
// FINANCIAL SAFETY:
//   All monetary values use Decimal (maps to PostgreSQL NUMERIC) — never Float.
//
// ARCHITECTURAL RULES:
//   - Product belongs to Seller (NOT Store)
//   - Inventory belongs to Store + ProductVariant
//   - One Seller can have multiple Stores
//   - Order snapshots are immutable historical records
//   - Commission is configurable and calculated server-side
//
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is required when using Supabase connection pooling (PgBouncer)
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMERATIONS
// =============================================================================

/// User roles in the system
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  // Future: SUPER_ADMIN, SUPPORT, DELIVERY_PARTNER
}

/// Seller KYC verification status
enum KycStatus {
  NOT_STARTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

/// Seller onboarding status
enum SellerOnboardingStatus {
  PROFILE_INCOMPLETE
  PROFILE_SUBMITTED
  KYC_PENDING
  KYC_VERIFIED
  STORE_CREATED
  ACTIVE
  SUSPENDED
}

/// Seller/store business type
enum BusinessType {
  INDIVIDUAL
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  PRIVATE_LIMITED
  LLP
  OTHER
}

/// Seller category (affects discovery, commission, future features)
enum SellerType {
  LOCAL_STORE
  ONLINE_SELLER
  BRAND
}

/// Product lifecycle status
enum ProductStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// Gender targeting for fashion products
enum ProductGender {
  MEN
  WOMEN
  UNISEX
  BOYS
  GIRLS
  KIDS
}

/// Order status (customer-facing)
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

/// Seller order status (seller-facing fulfillment)
enum SellerOrderStatus {
  PENDING
  ACCEPTED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_ACCEPTED
  RETURN_REJECTED
  RETURNED
  REFUNDED
}

/// Payment status — separate from order status
enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
  COD_PENDING      // COD order: collected after delivery
  COD_COLLECTED
}

/// Payment method
enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
  EMI
  COD
  OTHER
}

/// Payment provider
enum PaymentProvider {
  RAZORPAY
  COD
  // Future: STRIPE, etc.
}

/// Commission rule scope type
enum CommissionRuleType {
  GLOBAL            // Applies to all products (default fallback)
  CATEGORY          // Applies to a specific category
  SELLER            // Applies to a specific seller
  PRODUCT           // Applies to a specific product (highest priority override)
  PROMOTIONAL       // Time-limited promotional rate
}

/// Settlement status
enum SettlementStatus {
  PENDING
  ELIGIBLE
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}

/// Return/Exchange type
enum ReturnType {
  RETURN
  EXCHANGE
  SIZE_EXCHANGE
}

/// Return request status
enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  RECEIVED
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

/// Refund status
enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

/// Review/moderation status
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

/// Coupon discount type
enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Notification type
enum NotificationType {
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  REFUND_INITIATED
  REFUND_SUCCESS
  PAYMENT_FAILED
  SELLER_APPROVED
  SELLER_REJECTED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  SETTLEMENT_PROCESSED
  KYC_STATUS_CHANGE
  REVIEW_RECEIVED
  GENERAL
}

/// Notification delivery channel
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

/// Audit log action categories
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  VERIFY
  PROCESS
  CANCEL
  REFUND
  SETTLE
  CONFIGURE
  LOGIN
  LOGOUT
}

// =============================================================================
// AUTH — NextAuth.js v5 required tables
// =============================================================================

/// Platform users — customers, sellers, admins
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified Boolean   @default(false)
  name          String?
  image         String?   // Profile image URL

  /// Hashed password — null if using OAuth only
  passwordHash  String?

  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)

  // Soft delete — preserve data for audit/financial records
  deletedAt     DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // ----- Relations ----------------------------------------------------------
  accounts      Account[]
  sessions      Session[]

  sellerProfile SellerProfile?
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  couponUsages  CouponUsage[]

  /// Orders this admin has approved/processed
  adminOrderActions SellerOrder[] @relation("AdminActions")

  /// Products this admin approved
  approvedProducts Product[] @relation("ApprovedByAdmin")

  /// Audit log entries created by this user
  auditLogs     AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

/// NextAuth Account (OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// NextAuth Verification Token (email verification, magic links)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// SELLER PROFILE & ONBOARDING
// =============================================================================

/// Seller business profile — one-to-one with User (SELLER role)
model SellerProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique

  // Business identity
  businessName          String
  businessType          BusinessType           @default(INDIVIDUAL)
  sellerType            SellerType             @default(ONLINE_SELLER)
  displayName           String?                // Public-facing brand name
  description           String?                @db.Text
  logoUrl               String?

  // KYC / Legal — India-specific
  // IMPORTANT: Sensitive data handled by Razorpay where possible.
  // Only store non-sensitive references here.
  panNumber             String?                // Encrypted / masked at application level
  gstin                 String?                // Goods and Services Tax Identification Number
  bankAccountReference  String?                // Razorpay contact/fund account ID (NOT raw bank details)

  kycStatus             KycStatus              @default(NOT_STARTED)
  kycSubmittedAt        DateTime?
  kycVerifiedAt         DateTime?
  kycRejectionReason    String?                @db.Text

  onboardingStatus      SellerOnboardingStatus @default(PROFILE_INCOMPLETE)
  isActive              Boolean                @default(false)
  isSuspended           Boolean                @default(false)
  suspensionReason      String?                @db.Text

  // Business address
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  pincode               String?
  country               String                 @default("IN")

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // ----- Relations ----------------------------------------------------------
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  stores  Store[]
  products Product[]
  settlements Settlement[]
  commissionRules CommissionRule[] @relation("SellerCommissionRules")

  @@index([userId])
  @@index([kycStatus])
  @@index([onboardingStatus])
  @@map("seller_profiles")
}

// =============================================================================
// STORES & LOCATION
// =============================================================================

/// A physical or virtual store belonging to a Seller
/// One Seller can have multiple Stores
model Store {
  id          String  @id @default(cuid())
  sellerId    String
  name        String
  slug        String  @unique
  description String? @db.Text
  logoUrl     String?
  bannerUrl   String?

  // Location — designed for geospatial queries
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pincode      String?
  country      String  @default("IN")

  /// Latitude — stored for geospatial queries (use NUMERIC for precision)
  latitude     Decimal? @db.Decimal(10, 8)
  /// Longitude
  longitude    Decimal? @db.Decimal(11, 8)

  // Contact
  phone        String?
  email        String?

  isActive     Boolean  @default(true)
  isVerified   Boolean  @default(false)

  // Store operating hours (JSON — flexible for future structured hours)
  operatingHours Json?  // { monday: { open: "10:00", close: "21:00" }, ... }

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  serviceAreas StoreServiceArea[]
  inventory    Inventory[]
  sellerOrders SellerOrder[]

  @@index([sellerId])
  @@index([slug])
  @@index([pincode])
  @@index([city])
  @@index([isActive])
  @@map("stores")
}

/// Pincode/city serviceability for a Store
/// Determines which locations a store can fulfill orders to
model StoreServiceArea {
  id      String  @id @default(cuid())
  storeId String

  pincode String?
  city    String?
  state   String?

  /// Future: radius-based serviceability
  /// radiusKm Decimal? @db.Decimal(8, 2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([pincode])
  @@index([city])
  @@map("store_service_areas")
}

// =============================================================================
// CATEGORIES
// =============================================================================

/// Hierarchical product categories
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  parentId    String?

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  // Tax classification
  hsnCode     String? // Harmonised System Nomenclature (for GST)
  taxRate     Decimal? @db.Decimal(5, 2) // e.g. 5.00, 12.00, 18.00 — do NOT hard-code

  // Return policy flags
  isReturnable  Boolean @default(true)
  returnWindowDays Int  @default(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
  commissionRules CommissionRule[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

// =============================================================================
// PRODUCTS — belongs to SELLER, not Store
// =============================================================================

/// Master product — owned by a Seller
/// ARCHITECTURAL RULE: Product ≠ Store. One product can exist in multiple stores.
model Product {
  id          String @id @default(cuid())
  sellerId    String
  categoryId  String

  // Identity
  name        String
  slug        String @unique
  description String? @db.Text

  // Fashion attributes
  brand       String?
  gender      ProductGender?
  material    String?

  // Flexible fashion-specific attributes (e.g. pattern, occasion, fit)
  // Using JSON for extensibility without schema migrations
  fashionAttributes Json? // { "pattern": "Striped", "fit": "Slim", "occasion": "Casual" }

  // Care instructions
  careInstructions String? @db.Text

  // Status workflow
  status         ProductStatus @default(DRAFT)
  approvedById   String?
  approvedAt     DateTime?
  rejectionReason String? @db.Text

  // SEO
  metaTitle       String?
  metaDescription String?

  // Aggregate stats — maintained by background jobs / triggers
  averageRating Decimal? @db.Decimal(3, 2)
  reviewCount   Int      @default(0)

  isFeatured    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedBy User?       @relation("ApprovedByAdmin", fields: [approvedById], references: [id])

  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  wishlistItems WishlistItem[]
  commissionRules CommissionRule[] @relation("ProductCommissionRules")

  @@index([sellerId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([gender])
  @@index([brand])
  @@index([isFeatured])
  @@map("products")
}

/// Product variant — size + color combination
model ProductVariant {
  id            String  @id @default(cuid())
  productId     String

  sku           String  @unique
  size          String? // e.g. XS, S, M, L, XL, XXL, 28, 30, 32 (for bottoms)
  color         String? // e.g. "Navy Blue", "Off White"
  colorHex      String? // e.g. "#1B3A6B" — for color swatches

  /// Selling price — MUST be Decimal, never Float
  price         Decimal @db.Decimal(10, 2)

  /// Original/compare-at price (shown crossed out when discounted)
  compareAtPrice Decimal? @db.Decimal(10, 2)

  isActive      Boolean  @default(true)

  // Physical attributes (for future logistics)
  weightGrams   Int?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  returnExchangeTargets Return[] @relation("ExchangeTargetVariant")

  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
}

/// Product images
model ProductImage {
  id           String  @id @default(cuid())
  productId    String

  url          String  // Object storage URL
  altText      String?
  displayOrder Int     @default(0)
  isPrimary    Boolean @default(false)

  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// =============================================================================
// INVENTORY — belongs to STORE + PRODUCT VARIANT
// =============================================================================

/// Store-level inventory for a product variant
/// ARCHITECTURAL RULE: Inventory ∈ (Store, ProductVariant)
model Inventory {
  id        String @id @default(cuid())
  storeId   String
  variantId String

  /// Total physical stock quantity
  quantity          Int @default(0)

  /// Reserved quantity — items in active checkouts/unpaid orders
  /// availableQuantity = quantity - reservedQuantity
  reservedQuantity  Int @default(0)

  /// Alert threshold — notify seller when stock falls below this
  lowStockThreshold Int @default(5)

  updatedAt DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@index([storeId])
  @@index([variantId])
  @@index([quantity])
  @@map("inventory")
}

// =============================================================================
// ADDRESSES
// =============================================================================

/// Customer saved addresses
model Address {
  id     String @id @default(cuid())
  userId String

  // Recipient
  recipientName  String
  phone          String

  // Address fields
  line1          String
  line2          String?
  landmark       String?
  city           String
  state          String
  pincode        String
  country        String  @default("IN")

  // Geolocation (optional — for delivery estimation)
  latitude       Decimal? @db.Decimal(10, 8)
  longitude      Decimal? @db.Decimal(11, 8)

  isDefault      Boolean  @default(false)

  // Soft delete — addresses referenced by orders must be preserved
  deletedAt      DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pincode])
  @@map("addresses")
}

// =============================================================================
// CART
// =============================================================================

/// Shopping cart — one per user
model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

/// Cart line item
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  storeId   String   // Track which store this item is from (multi-seller cart)
  quantity  Int

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, storeId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

// =============================================================================
// ORDERS
// ARCHITECTURAL RULE: Parent Order → Seller Orders → Order Items
// =============================================================================

/// Parent order — represents one customer checkout session
/// May contain items from multiple sellers
model Order {
  id         String      @id @default(cuid())
  customerId String

  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING)

  // Shipping address — SNAPSHOT (immutable historical record)
  // Never join to the addresses table for display of old orders
  shippingAddressSnapshot Json
  // {
  //   "recipientName": "...",
  //   "phone": "...",
  //   "line1": "...",
  //   "line2": "...",
  //   "landmark": "...",
  //   "city": "...",
  //   "state": "...",
  //   "pincode": "...",
  //   "country": "IN"
  // }

  // Financial totals — all Decimal, calculated server-side
  subtotal       Decimal @db.Decimal(10, 2) // Sum of item totals before fees/discounts
  deliveryFee    Decimal @db.Decimal(10, 2) @default(0)
  discount       Decimal @db.Decimal(10, 2) @default(0)
  taxAmount      Decimal @db.Decimal(10, 2) @default(0)
  totalAmount    Decimal @db.Decimal(10, 2) // Final amount charged

  couponId       String?
  couponDiscount Decimal @db.Decimal(10, 2) @default(0)

  // Payment method — determines flow (online vs COD)
  paymentMethod  PaymentMethod?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  sellerOrders SellerOrder[]
  payment      Payment?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// Seller-specific order — one per seller in a parent order
model SellerOrder {
  id       String @id @default(cuid())
  orderId  String
  sellerId String
  storeId  String

  status SellerOrderStatus @default(PENDING)

  // Financial — Decimal, calculated server-side
  subtotal         Decimal @db.Decimal(10, 2)
  deliveryFee      Decimal @db.Decimal(10, 2) @default(0)
  commissionRate   Decimal @db.Decimal(5, 4)   // e.g. 0.1000 = 10%
  commissionAmount Decimal @db.Decimal(10, 2)
  sellerAmount     Decimal @db.Decimal(10, 2)  // subtotal - commissionAmount

  // Fulfillment info
  trackingNumber   String?
  trackingProvider String?
  shippedAt        DateTime?
  deliveredAt      DateTime?

  // Admin actions
  processedByAdminId String?

  cancelledAt       DateTime?
  cancellationReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  processedByAdmin User? @relation("AdminActions", fields: [processedByAdminId], references: [id])

  items       OrderItem[]
  settlement  Settlement?
  returns     Return[]

  @@index([orderId])
  @@index([sellerId])
  @@index([storeId])
  @@index([status])
  @@map("seller_orders")
}

/// Individual order line item — contains snapshots for historical integrity
model OrderItem {
  id            String @id @default(cuid())
  sellerOrderId String
  variantId     String // Keep FK for reference, but use snapshots for display

  // SNAPSHOTS — immutable point-in-time record
  // These must be populated at order creation time from current product data
  productNameSnapshot  String  // Product name at time of order
  variantSnapshot      Json    // { "size": "M", "color": "Navy Blue", "sku": "UN-001-M-NB" }
  skuSnapshot          String  // SKU at time of order
  imageUrlSnapshot     String? // Primary image URL at time of order

  unitPrice    Decimal @db.Decimal(10, 2) // Price at time of order
  quantity     Int
  totalPrice   Decimal @db.Decimal(10, 2) // unitPrice × quantity

  createdAt    DateTime @default(now())

  // ----- Relations ----------------------------------------------------------
  sellerOrder SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  review      Review?
  returns     Return[]

  @@index([sellerOrderId])
  @@index([variantId])
  @@map("order_items")
}

// =============================================================================
// PAYMENTS
// =============================================================================

/// Payment record — one per order
/// Financial audit trail: never overwrite, update status only
model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  method   PaymentMethod?
  provider PaymentProvider

  status   PaymentStatus @default(PENDING)

  // Provider-specific references — populated after provider interaction
  providerOrderId   String? // e.g. Razorpay order_id
  providerPaymentId String? // e.g. Razorpay payment_id
  providerSignature String? // For webhook verification (hashed, not raw)

  // COD-specific
  codCollectedAt    DateTime?

  // Metadata — provider-returned data for audit
  providerMetadata  Json?    @db.JsonB

  failureReason     String?
  failedAt          DateTime?
  capturedAt        DateTime?
  refundedAt        DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

// =============================================================================
// COMMISSION RULES
// Configurable, priority-based, server-side only
// =============================================================================

/// Commission rule — defines what percentage UrbanNest takes
/// Priority (highest wins): PRODUCT > SELLER > CATEGORY > PROMOTIONAL > GLOBAL
model CommissionRule {
  id   String             @id @default(cuid())
  type CommissionRuleType @default(GLOBAL)

  // Typed FKs — only one will be non-null at a time, based on rule type:
  //   GLOBAL:      all null
  //   CATEGORY:    categoryId set
  //   SELLER:      sellerId set
  //   PRODUCT:     productId set
  //   PROMOTIONAL: all null (or categoryId if category-scoped promo)
  categoryId String?
  sellerId   String?
  productId  String?

  /// Commission rate as a decimal fraction — e.g. 0.10 = 10%
  rate        Decimal @db.Decimal(5, 4)

  /// Minimum commission amount per order item (optional)
  minAmount   Decimal? @db.Decimal(10, 2)

  isActive    Boolean  @default(true)

  /// Effective date range for promotional or time-limited rates
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  description   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?  // Admin who created this rule

  // ----- Relations ----------------------------------------------------------
  category Category?      @relation(fields: [categoryId], references: [id])
  seller   SellerProfile? @relation("SellerCommissionRules", fields: [sellerId], references: [id])
  product  Product?       @relation("ProductCommissionRules", fields: [productId], references: [id])

  @@index([type])
  @@index([categoryId])
  @@index([sellerId])
  @@index([productId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("commission_rules")
}


// =============================================================================
// SETTLEMENTS
// =============================================================================

/// Settlement record — tracks payout to seller after order completion
model Settlement {
  id            String           @id @default(cuid())
  sellerOrderId String           @unique
  sellerId      String

  // All amounts in Decimal — server-side calculated, auditable
  grossAmount      Decimal @db.Decimal(10, 2) // Total seller order value
  commissionAmount Decimal @db.Decimal(10, 2) // UrbanNest commission
  refundAmount     Decimal @db.Decimal(10, 2) @default(0) // Deducted for returns
  adjustmentAmount Decimal @db.Decimal(10, 2) @default(0) // Manual adjustments
  netAmount        Decimal @db.Decimal(10, 2) // Amount actually paid to seller

  status            SettlementStatus @default(PENDING)
  settlementReference String?        // Razorpay Route transfer ID or bank reference

  // Eligibility tracking
  eligibleAt        DateTime?  // When return window closed
  processedAt       DateTime?
  paidAt            DateTime?

  notes             String?    @db.Text
  failureReason     String?

  // Provider metadata
  providerMetadata  Json?      @db.JsonB

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // ----- Relations ----------------------------------------------------------
  sellerOrder SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId])
  @@index([sellerId])
  @@index([status])
  @@index([eligibleAt])
  @@map("settlements")
}

// =============================================================================
// RETURNS & EXCHANGES
// =============================================================================

/// Return or exchange request
model Return {
  id            String       @id @default(cuid())
  sellerOrderId String
  orderItemId   String

  type          ReturnType
  status        ReturnStatus @default(REQUESTED)

  // Customer-stated reason
  reason        String
  reasonDetails String?      @db.Text

  // For SIZE_EXCHANGE: which variant is requested
  exchangeVariantId String?

  // Review notes
  adminNotes    String?      @db.Text
  sellerNotes   String?      @db.Text

  // Timeline
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  approvedAt    DateTime?
  rejectedAt    DateTime?
  pickupScheduledAt DateTime?
  pickedUpAt    DateTime?
  receivedAt    DateTime?
  completedAt   DateTime?

  // Policy snapshot at time of request
  returnWindowDays Int?       // Captured from category at request time

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // ----- Relations ----------------------------------------------------------
  sellerOrder     SellerOrder    @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  exchangeVariant ProductVariant? @relation("ExchangeTargetVariant", fields: [exchangeVariantId], references: [id])
  refund          Refund?

  @@index([sellerOrderId])
  @@index([orderItemId])
  @@index([status])
  @@index([type])
  @@map("returns")
}

/// Refund record — linked to return and/or payment
model Refund {
  id        String @id @default(cuid())
  returnId  String? @unique
  paymentId String

  amount    Decimal @db.Decimal(10, 2)
  status    RefundStatus @default(PENDING)

  // Provider reference
  provider           PaymentProvider
  providerRefundId   String?  // e.g. Razorpay refund ID
  providerMetadata   Json?    @db.JsonB

  failureReason      String?
  initiatedAt        DateTime @default(now())
  processedAt        DateTime?
  completedAt        DateTime?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  return  Return?  @relation(fields: [returnId], references: [id])
  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// =============================================================================
// REVIEWS
// =============================================================================

/// Product review — tied to a verified purchase (OrderItem)
/// Prevents fake or unverified reviews
model Review {
  id          String       @id @default(cuid())
  orderItemId String       @unique // One review per order item
  customerId  String
  productId   String

  rating      Int          // 1–5
  title       String?
  comment     String?      @db.Text

  status      ReviewStatus @default(PENDING)
  moderationNote String?

  // Future: seller response
  sellerResponse String?   @db.Text
  sellerRespondedAt DateTime?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // ----- Relations ----------------------------------------------------------
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  customer  User      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@index([rating])
  @@map("reviews")
}

// =============================================================================
// WISHLIST
// =============================================================================

/// Customer wishlist — one per user
model Wishlist {
  id     String @id @default(cuid())
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

/// Wishlist item
model WishlistItem {
  id         String @id @default(cuid())
  wishlistId String
  productId  String

  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

// =============================================================================
// COUPONS
// =============================================================================

/// Coupon/promo code
model Coupon {
  id   String     @id @default(cuid())
  code String     @unique
  type CouponType

  /// Discount value — percentage (e.g. 10.00 = 10%) or fixed (e.g. 100.00 = ₹100)
  value              Decimal @db.Decimal(10, 2)

  /// Minimum order amount for coupon to be applicable
  minOrderAmount     Decimal? @db.Decimal(10, 2)

  /// Maximum discount cap (for percentage coupons)
  maxDiscountAmount  Decimal? @db.Decimal(10, 2)

  /// Total usage limit (null = unlimited)
  usageLimit         Int?

  /// Per-user usage limit (null = unlimited per user)
  perUserLimit       Int?

  usedCount          Int      @default(0)
  isActive           Boolean  @default(true)

  validFrom          DateTime
  validTo            DateTime

  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // ----- Relations ----------------------------------------------------------
  orders     Order[]
  usages     CouponUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validTo])
  @@map("coupons")
}

/// Tracks per-user coupon usage to enforce perUserLimit
model CouponUsage {
  id       String @id @default(cuid())
  couponId String
  userId   String
  orderId  String @unique

  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([couponId, userId, orderId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

/// In-app and multi-channel notification record
model Notification {
  id      String             @id @default(cuid())
  userId  String
  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  title   String
  body    String             @db.Text
  isRead  Boolean            @default(false)

  // Context/deep-link data
  metadata Json?             // { "orderId": "...", "actionUrl": "/orders/..." }

  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// AUDIT LOG
// Important business events — append-only, never deleted
// =============================================================================

/// Immutable audit log entry
/// Created for every important admin/system action
model AuditLog {
  id          String      @id @default(cuid())

  actorId     String?     // User who performed the action (null = system)
  actorRole   UserRole?

  action      AuditAction
  entityType  String      // e.g. "Product", "SellerOrder", "CommissionRule"
  entityId    String      // The affected record's ID

  // Before/after changes (null for create/delete)
  changes     Json?       // { "before": {...}, "after": {...} }

  // Request context
  ipAddress   String?
  userAgent   String?

  // Additional context
  notes       String?     @db.Text

  createdAt   DateTime    @default(now())

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
