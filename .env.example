# =============================================================================
# UrbanNest — Environment Variables Template
# =============================================================================
# Copy this file to .env.local for development.
# NEVER commit .env.local or any file containing real secrets.
#
# Variables marked [REQUIRED] must be set before the application can run.
# Variables marked [OPTIONAL] have safe defaults or are for future use.
# Variables marked [PRODUCTION] must be configured before going live.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# [REQUIRED] Public base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [REQUIRED] Environment: development | staging | production
NODE_ENV=development

# [OPTIONAL] Application name shown in emails and UI
NEXT_PUBLIC_APP_NAME=UrbanNest


# -----------------------------------------------------------------------------
# Database — PostgreSQL (Supabase)
# -----------------------------------------------------------------------------
# [REQUIRED] Full PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Supabase: Settings → Database → Connection String → URI
# For local development, use a local PostgreSQL instance or Supabase dev project.
# NEVER use the production database for local development.
DATABASE_URL=postgresql://postgres:password@localhost:5432/urbannest_dev?schema=public

# [PRODUCTION] Direct connection URL for migrations (bypasses connection pooler)
# Required when using Supabase connection pooling (PgBouncer)
# Format: postgresql://postgres:password@db.PROJECTREF.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@localhost:5432/urbannest_dev?schema=public


# -----------------------------------------------------------------------------
# Authentication — Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# [REQUIRED] Secret for signing tokens and sessions
# Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS

# [REQUIRED] Canonical URL of your site (used for OAuth callbacks)
AUTH_URL=http://localhost:3000

# [OPTIONAL] Google OAuth — configure in Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Future: additional OAuth providers
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Razorpay — Payment Gateway
# -----------------------------------------------------------------------------
# [PRODUCTION] Razorpay API credentials
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
#
# Use TEST keys in development: rzp_test_...
# Use LIVE keys ONLY in production: rzp_live_...
#
# CAUTION: Live keys process real money. Never use live keys in development.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET

# [PRODUCTION] Razorpay webhook secret
# Generate a strong secret in Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# [REQUIRED] Public Razorpay key (safe to expose to browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_TEST_KEY_ID


# -----------------------------------------------------------------------------
# Razorpay Route — Marketplace Settlement
# -----------------------------------------------------------------------------
# [PRODUCTION] Razorpay Route enables marketplace payouts to sellers
# https://razorpay.com/docs/route/
#
# Note: Razorpay Route requires a separate agreement with Razorpay.
# Must NOT be used until properly onboarded with Razorpay Route.
# Set to false in development to disable real payouts.
RAZORPAY_ROUTE_ENABLED=false


# -----------------------------------------------------------------------------
# Object Storage — Product Images
# -----------------------------------------------------------------------------
# [PRODUCTION] Configure one of: Cloudflare R2, AWS S3, or compatible service
#
# OPTION A: Cloudflare R2 (recommended for cost efficiency)
# https://dash.cloudflare.com → R2 Object Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=urbannest-products
R2_PUBLIC_URL=https://REPLACE_WITH_YOUR_R2_PUBLIC_DOMAIN

# OPTION B: AWS S3 (uncomment and fill if using S3)
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=urbannest-products

# [OPTIONAL] Max upload size in MB (default: 5)
UPLOAD_MAX_SIZE_MB=5


# -----------------------------------------------------------------------------
# Email — Transactional
# -----------------------------------------------------------------------------
# [PRODUCTION] Configure email provider for transactional emails
# Recommended: Resend (https://resend.com)
#
# EMAIL_PROVIDER: resend | smtp | console (console logs to terminal in dev)
EMAIL_PROVIDER=console

# Resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=noreply@urbannest.in

# SMTP fallback (if using SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false


# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# [OPTIONAL] Rate limiting configuration
# Currently uses in-memory rate limiting. Upgrade to Redis for production scale.
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# [OPTIONAL] Log level: error | warn | info | debug
LOG_LEVEL=info

# [OPTIONAL] Enable audit logging to database
AUDIT_LOG_ENABLED=true


# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# [OPTIONAL] Enable/disable features before full launch
FEATURE_COD_ENABLED=true
FEATURE_GOOGLE_AUTH_ENABLED=false
FEATURE_RAZORPAY_ROUTE_ENABLED=false
FEATURE_REVIEWS_ENABLED=true
FEATURE_WISHLIST_ENABLED=true
FEATURE_COUPONS_ENABLED=false


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# [OPTIONAL] Allowed origins for CORS (comma-separated)
# Leave empty in development (all origins allowed)
ALLOWED_ORIGINS=

# [PRODUCTION] Strict Content Security Policy (set before go-live)
# CSP_HEADER=


# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# [REQUIRED] Initial admin user — used only for first-run seeding
# Remove or rotate after first admin account is created via UI
ADMIN_SEED_EMAIL=admin@urbannest.in
ADMIN_SEED_PASSWORD=REPLACE_WITH_STRONG_INITIAL_ADMIN_PASSWORD


# =============================================================================
# SETUP CHECKLIST (before going to production)
# =============================================================================
# [ ] Set real DATABASE_URL and DIRECT_URL to Supabase production project
# [ ] Generate a strong AUTH_SECRET (openssl rand -base64 32)
# [ ] Configure Razorpay LIVE keys (rzp_live_...)
# [ ] Set up Razorpay Webhook and configure RAZORPAY_WEBHOOK_SECRET
# [ ] Onboard with Razorpay Route and set RAZORPAY_ROUTE_ENABLED=true
# [ ] Configure R2 or S3 bucket for product images
# [ ] Set up Resend (or SMTP) and configure email credentials
# [ ] Configure Google OAuth (if social login is enabled)
# [ ] Rotate ADMIN_SEED_PASSWORD or remove after first admin is created
# [ ] Set NODE_ENV=production
# [ ] Set NEXT_PUBLIC_APP_URL to production domain
# [ ] Review and set ALLOWED_ORIGINS
# =============================================================================
